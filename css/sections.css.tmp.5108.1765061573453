/* ==========================================================================
   Section Styles
   ========================================================================== */

/* Scroll Progress Bar */
.scroll-progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  background: var(--color-accent-primary);
  width: 0%;
  z-index: 1001;
  transition: width 0.1s ease-out;
  box-shadow: 0 0 10px var(--color-accent-primary);
}

/* Scroll to Top Button */
.scroll-top {
  position: fixed;
  bottom: var(--space-6);
  right: var(--space-6);
  width: 50px;
  height: 50px;
  background: var(--color-bg-tertiary);
  border: 1px solid var(--color-border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-accent-primary);
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: all var(--transition-base);
  z-index: 999;
}

.scroll-top:hover {
  background: var(--color-accent-primary);
  color: var(--color-bg-primary);
  border-color: var(--color-accent-primary);
  transform: translateY(0) scale(1.1);
  box-shadow: 0 0 20px var(--color-accent-alpha-40);
}

.scroll-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.scroll-top svg {
  width: 24px;
  height: 24px;
}

/* Base Section */
.section {
  padding: var(--space-12) 0;
  position: relative;
}

.section--alt {
  background-color: var(--color-bg-secondary);
}

/* Grid background pattern */
.section--grid {
  background-image:
    linear-gradient(var(--color-accent-alpha-02) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-accent-alpha-02) 1px, transparent 1px);
  background-size: 40px 40px;
}

.section__label {
  font-family: var(--font-mono);
  font-size: var(--font-size-xs);
  color: var(--color-accent-primary);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: var(--space-3);
  display: block;
}

.section__title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  margin-bottom: var(--space-6);
  color: var(--color-text-primary);
}

@media (min-width: 768px) {
  .section {
    padding: var(--space-12) 0;
  }

  .section__title {
    font-size: var(--font-size-3xl);
  }
}

/* ==========================================================================
   Hero Section
   ========================================================================== */

.hero {
  min-height: 100vh;
  display: flex;
  align-items: flex-end;
  padding-top: var(--nav-height);
  padding-bottom: var(--space-12);
  background-color: #000000;
  position: relative;
  overflow: hidden;
}

@media (min-width: 768px) {
  .hero {
    align-items: center;
    padding-bottom: 0;
  }
}


.hero__content {
  position: relative;
  z-index: 2;
  margin-top: 10px;
  max-width: 450px;
}

@media (min-width: 768px) {
  .hero__content {
    margin-top: 0;
    max-width: 500px;
  }
}

.hero__subtitle,
.hero__tagline {
  color: rgba(255, 255, 255, 1) !important;
}

.hero__label {
  font-family: var(--font-mono);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: var(--space-4);
  display: block;
}

.hero__title {
  font-size: var(--font-size-4xl);
  font-weight: var(--font-weight-bold);
  margin-bottom: var(--space-3);
  line-height: 1.1;
}

.hero__subtitle {
  font-size: var(--font-size-xl);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
}

.hero__tagline {
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
  margin-bottom: var(--space-8);
}

.hero__contact {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.hero__contact-item {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  transition: color var(--transition-fast);
  overflow: hidden;
}

.hero__contact-item span,
.hero__contact-item::after {
  max-width: 0;
  opacity: 0;
  white-space: nowrap;
  transition: max-width 0.3s ease, opacity 0.3s ease;
}

.hero__contact-item:hover span,
.hero__contact-item:hover::after {
  max-width: 300px;
  opacity: 1;
}

.hero__contact-item:hover {
  color: var(--color-accent-primary);
}

.hero__contact-item svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: var(--color-accent-primary);
}

@media (min-width: 768px) {
  .hero__title {
    font-size: var(--font-size-5xl);
  }

  .hero__subtitle {
    font-size: var(--font-size-2xl);
  }
}

/* Hero Background Photo */
.hero {
  background-image: url('../images/portrait_optimized.jpg');
  background-size: cover;
  background-position: center calc(30%);
  background-repeat: no-repeat;
  transition: background-image 0.3s ease;
}

@media (min-width: 768px) {
  .hero {
    background-position: center calc(30% - 5px);
  }
}

/* Overlay for text readability - dark mode */
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(10, 10, 11, 1) 0%,
    rgba(10, 10, 11, 1) 5%,
    rgba(10, 10, 11, 0.98) 10%,
    rgba(10, 10, 11, 0.95) 15%,
    rgba(10, 10, 11, 0.90) 20%,
    rgba(10, 10, 11, 0.82) 25%,
    rgba(10, 10, 11, 0.72) 30%,
    rgba(10, 10, 11, 0.60) 35%,
    rgba(10, 10, 11, 0.45) 40%,
    rgba(10, 10, 11, 0.28) 45%,
    rgba(10, 10, 11, 0.12) 48%,
    rgba(10, 10, 11, 0) 50%
  );
  pointer-events: none;
  transition: background 0.3s ease, opacity 0.3s ease;
}

/* Light mode image preload via ::before (always present, just hidden in dark mode) */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('../images/ChatGPT Image Dec 4, 2025, 06_34_15 PM.png');
  background-size: cover;
  background-position: calc(50% - 15px) calc(30% + 20px);
  z-index: 0;
  opacity: 0;
  transition: opacity 0.3s ease;
}

/* Light mode photo */
[data-theme="light"] .hero {
  background-image: none;
}

[data-theme="light"] .hero::before {
  opacity: 1;
}

@media (min-width: 768px) {
  .hero::before {
    background-size: 103%;
    background-position: calc(50% - 25px) calc(30% + 35px);
  }
}

[data-theme="light"] .hero::after {
  display: block;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0) 50%,
    rgba(255, 255, 255, 0.1) 55%,
    rgba(255, 255, 255, 0.22) 60%,
    rgba(255, 255, 255, 0.35) 65%,
    rgba(255, 255, 255, 0.5) 70%,
    rgba(255, 255, 255, 0.65) 75%,
    rgba(255, 255, 255, 0.8) 80%,
    rgba(255, 255, 255, 0.9) 85%,
    rgba(255, 255, 255, 0.97) 90%,
    rgba(255, 255, 255, 1) 95%
  );
}

@media (min-width: 768px) {
  [data-theme="light"] .hero::after {
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 255, 255, 0.93) 2.5%,
      rgba(255, 255, 255, 0.91) 5%,
      rgba(255, 255, 255, 0.88) 7.5%,
      rgba(255, 255, 255, 0.85) 10%,
      rgba(255, 255, 255, 0.81) 12.5%,
      rgba(255, 255, 255, 0.77) 15%,
      rgba(255, 255, 255, 0.72) 17.5%,
      rgba(255, 255, 255, 0.67) 20%,
      rgba(255, 255, 255, 0.62) 22.5%,
      rgba(255, 255, 255, 0.56) 25%,
      rgba(255, 255, 255, 0.50) 27.5%,
      rgba(255, 255, 255, 0.44) 30%,
      rgba(255, 255, 255, 0.38) 32.5%,
      rgba(255, 255, 255, 0.32) 35%,
      rgba(255, 255, 255, 0.26) 37.5%,
      rgba(255, 255, 255, 0.20) 40%,
      rgba(255, 255, 255, 0.15) 42.5%,
      rgba(255, 255, 255, 0.10) 45%,
      rgba(255, 255, 255, 0.05) 47.5%,
      rgba(255, 255, 255, 0) 50%
    );
  }
}

[data-theme="light"] .hero__subtitle,
[data-theme="light"] .hero__tagline {
  color: #000000 !important;
  font-weight: 500;
}

/* ==========================================================================
   Profile Section
   ========================================================================== */

.profile__text {
  max-width: 800px;
}

.profile__text p {
  font-size: var(--font-size-lg);
  line-height: var(--line-height-relaxed);
  margin-bottom: var(--space-5);
}

@media (min-width: 768px) {
  .profile__text p {
    font-size: var(--font-size-xl);
  }
}

/* ==========================================================================
   Tools Section
   ========================================================================== */

.tools-category {
  margin-bottom: var(--space-6);
}

.tools-category:last-child {
  margin-bottom: 0;
}

.tools-category__title {
  font-family: var(--font-mono);
  font-size: var(--font-size-sm);
  color: var(--color-accent-primary);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: var(--space-3);
}

/* ==========================================================================
   Awards Section
   ========================================================================== */

.award-card {
  background: var(--color-bg-tertiary);
  border: 2px solid var(--color-accent-primary);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  min-height: 250px;
  max-height: 250px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.award-card__description {
  transition: opacity 0.3s ease;
}

.award-card.is-expanded .award-card__title,
.award-card.is-expanded .award-card__description {
  opacity: 0;
}

.award-card__title {
  transition: opacity 0.3s ease;
}

.award-card__description {
  flex-grow: 1;
}

.award-card--featured {
  border-color: var(--color-accent-primary);
  background: linear-gradient(
    135deg,
    var(--color-accent-alpha-08) 0%,
    transparent 50%
  );
}

.award-card__title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  line-height: 1.3;
  margin-bottom: var(--space-3);
  color: var(--color-text-primary);
}

.award-card__icon {
  position: absolute;
  top: var(--space-5);
  right: var(--space-5);
  opacity: 0;
  color: var(--color-accent-primary);
  transition: opacity 0.4s ease-out, transform 0.2s ease;
  transition-delay: 0.2s;
}

.award-card.is-expanded .award-card__icon {
  opacity: 1;
}

.award-card:hover .award-card__icon {
  transform: translate(2px, -2px);
}

.award-card__description {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: var(--line-height-relaxed);
}

/* ==========================================================================
   Education Section
   ========================================================================== */

.education-card {
  background: var(--color-bg-tertiary);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  max-width: 500px;
}

.education-card__degree {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.education-card__school {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-1);
}

.education-card__date {
  font-family: var(--font-mono);
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

/* ==========================================================================
   Languages Section
   ========================================================================== */

.languages {
  display: flex;
  gap: var(--space-6);
  flex-wrap: wrap;
}

.language {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.language__name {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.language__level {
  font-family: var(--font-mono);
  font-size: var(--font-size-sm);
  color: var(--color-accent-primary);
}

/* ==========================================================================
   Footer
   ========================================================================== */

.footer {
  background-color: var(--color-bg-secondary);
  border-top: 1px solid var(--color-border);
  padding: var(--space-8) 0;
}

.footer__content {
  text-align: center;
}

.footer__name {
  font-family: var(--font-mono);
  font-size: var(--font-size-lg);
  color: var(--color-accent-primary);
  margin-bottom: var(--space-3);
}

.footer__links {
  display: flex;
  justify-content: center;
  gap: var(--space-5);
  margin-bottom: var(--space-4);
  flex-wrap: wrap;
}

.footer__link {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  transition: color var(--transition-fast);
}

.footer__link:hover {
  color: var(--color-accent-primary);
}

.footer__copyright {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}
